{
  "info": {
    "name": "Replenishment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "requestedBy",
      "value": "postman-user"
    }
  ],
  "item": [
    {
      "name": "Session-based bulk loads",
      "item": [
        {
          "name": "POST CD ecom bulk",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"filePath\": \"C:\\\\Data\\\\CD_ecom.xlsx\"\n}"},
            "url": "{{baseUrl}}/cdecom/v1.0/bulk?requestedBy={{requestedBy}}"
          }
        },
        {
          "name": "POST CD data bulk",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"filePath\": \"C:\\\\Data\\\\CD_data.xlsx\"\n}"},
            "url": "{{baseUrl}}/cddata/v1.0/bulk?requestedBy={{requestedBy}}"
          }
        },
        {
          "name": "POST weekly data bulk",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"filePath\": \"C:\\\\Data\\\\Weekly_data.xlsx\"\n}"},
            "url": "{{baseUrl}}/weeklydata/v1.0/bulk?requestedBy={{requestedBy}}"
          }
        },
        {
          "name": "POST sales by channel bulk",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"filePath\": \"C:\\\\Data\\\\Sales_by_channel.xlsx\"\n}"},
            "url": "{{baseUrl}}/salesbychannel/v1.0/bulk?requestedBy={{requestedBy}}"
          }
        },
        {
          "name": "POST store turnover v2 bulk",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"filePath\": \"C:\\\\Data\\\\Store_turnover.csv\"\n}"},
            "url": "{{baseUrl}}/storeturnover/v2.0/bulk?requestedBy={{requestedBy}}"
          }
        }
      ]
    },
    {
      "name": "Universal deletion",
      "item": [
        {
          "name": "GET datasets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/data/v1.0/datasets"
          }
        },
        {
          "name": "GET dataset fields",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/data/v1.0/datasets/CD_DATA/fields"
          }
        },
        {
          "name": "DELETE dry-run",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset\": \"CD_DATA\",\n  \"filters\": {\n    \"god\": 2026,\n    \"sezon\": 2\n  },\n  \"dryRun\": true\n}"
            },
            "url": "{{baseUrl}}/data/v1.0/delete?requestedBy={{requestedBy}}"
          }
        },
        {
          "name": "DELETE one filter",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset\": \"CD_DATA\",\n  \"requestedBy\": \"postman-user\",\n  \"filters\": {\n    \"god\": 2026\n  },\n  \"dryRun\": false\n}"
            },
            "url": "{{baseUrl}}/data/v1.0/delete?requestedBy={{requestedBy}}"
          }
        },
        {
          "name": "DELETE multiple filters",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset\": \"CD_DATA\",\n  \"requestedBy\": \"postman-user\",\n  \"filters\": {\n    \"god\": 2026,\n    \"sezon\": 2,\n    \"store_rus\": \"ЦС\"\n  },\n  \"dryRun\": false\n}"
            },
            "url": "{{baseUrl}}/data/v1.0/delete"
          }
        },
        {
          "name": "Invalid dataset",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"dataset\":\"UNKNOWN\",\"filters\":{\"god\":2026}}"},
            "url": "{{baseUrl}}/data/v1.0/delete"
          }
        },
        {
          "name": "Invalid field",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"dataset\":\"CD_DATA\",\"filters\":{\"unknown\":1}}"},
            "url": "{{baseUrl}}/data/v1.0/delete"
          }
        },
        {
          "name": "Empty filters",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"dataset\":\"CD_DATA\",\"filters\":{}}"},
            "url": "{{baseUrl}}/data/v1.0/delete"
          }
        },
        {
          "name": "Invalid value type",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"dataset\":\"CD_DATA\",\"filters\":{\"god\":\"abc\"}}"},
            "url": "{{baseUrl}}/data/v1.0/delete"
          }
        }
      ]
    }
  ]
}
